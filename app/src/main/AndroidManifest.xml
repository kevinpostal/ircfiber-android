<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Image viewer Save to Photos / Save to Camera Roll on API 26-28 only; API 29+ MediaStore needs none. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".FiberIrcApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.FiberIrc"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <!-- Firebase starts by hand (data/push/Firebase.kt) only when fiberirc.fcmApiKey is set (M12). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Sentry starts by hand (data/crash/SentryInit.kt) only when fiberirc.sentryDsn is set. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth sign-in returns here from the Custom Tab (M2 §4): fiberirc://auth?code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fiberirc" android:host="auth" />
            </intent-filter>
            <!-- In-app buffer links / conversation shortcuts (M5 §5, M14 §2): fiberirc://buffer/<net>/<buf> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fiberirc" android:host="buffer" />
            </intent-filter>
            <!-- ircs://host[:port]/chan[,chan] and irc:// scheme links (M5 §5). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="irc" />
                <data android:scheme="ircs" />
            </intent-filter>
            <!-- App Links for https://ircfiber.com/irc/* (M5 §5). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ircfiber.com" android:pathPrefix="/irc" />
            </intent-filter>
            <!-- Sharing shortcuts (Direct Share, M13/M14): <share-target> → ui.share.ShareTargetActivity. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- System share sheet target (M13): one file and/or text to a channel or conversation. -->
        <activity
            android:name=".ui.share.ShareTargetActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FiberIrc.Share"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Only the first attachment is sent (iOS takes at most one file). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Shares files the app writes to its cache dir (diagnostics export, log export, camera captures). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- FCM pushes → conversation notifications (M12). -->
        <service
            android:name=".data.push.FiberIrcMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- A notification's Reply, sent without opening the app (M12). -->
        <receiver
            android:name=".data.push.PushReplyReceiver"
            android:exported="false" />
    </application>
</manifest>
